# =================================
# Antigravity — .gitignore
# =================================

# Dependencies
node_modules/
.pnpm-store/

# Build output
.next/
out/
dist/
build/

# Environment & Secrets (NEVER commit)
.env
.env.local
.env.*.local
*.pem
credentials.json
token.json

# Supabase (third-party repo clone with its own .git)
# Antigravity migrations tracked separately in database/
supabase/
C:/supabase-volumes/

# Temporary & intermediate files
.tmp/
*.tmp
*.log

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Test coverage
coverage/
.nyc_output/

# Storybook
storybook-static/

# PWA
sw.js
workbox-*.js

# Docker override (local dev only)
docker-compose.override.yml

API KEYS
auth_err.txt
auth_out.txt
auth_logs.txt
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Security Scan & Temporary Files
*_hits.txt
hardcoded_scan_results*.txt
find_hardcoded.js
execution/*test_mfa*.mjs
execution/*test_mfa*.py
