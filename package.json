{
  "name": "@stayassist/platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 --webpack",
    "dev:inngest": "inngest-cli dev -u http://localhost:3000/api/inngest",
    "build": "next build --webpack",
    "analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "clean:next": "node scripts/clean-next-cache.mjs",
    "typegen": "next typegen",
    "typecheck": "tsc --project tsconfig.typecheck.json --noEmit --pretty false",
    "typecheck:next": "next typegen && tsc --noEmit --pretty false",
    "typecheck:fresh": "node scripts/clean-next-cache.mjs && next typegen && tsc --noEmit --pretty false",
    "supabase:sync-workdir": "node scripts/sync-supabase-cli-workdir.mjs",
    "supabase:link": "npx supabase link --workdir database/supabase-cli",
    "supabase:db:push:dry-run": "npx supabase db push --linked --workdir database/supabase-cli --dry-run --yes",
    "supabase:db:push": "npx supabase db push --linked --workdir database/supabase-cli --yes",
    "sla:breaches:dry-run": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/backfill-sla-breaches.mjs --dry-run",
    "sla:breaches:apply": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/backfill-sla-breaches.mjs --apply"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.3.4",
    "@logtail/next": "^0.3.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/nextjs": "^10.43.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.0",
    "@simplewebauthn/types": "^12.0.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.98.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/qrcode": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.35.1",
    "inngest": "^4.4.0",
    "ioredis": "^5.10.0",
    "json2csv": "6.0.0-alpha.2",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "otplib": "^13.3.0",
    "pdf-lib": "^1.17.1",
    "pdfmake": "^0.3.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.6",
    "@tailwindcss/postcss": "^4",
    "@types/json2csv": "^5.0.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "inngest-cli": "^1.19.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "undici": ">=7.24.0",
      "serialize-javascript": ">=6.0.2"
    }
  }
}
