## Proposed Changes

### Component 1: Database Schema

#### [NEW] [025_user_departments.sql](file:///c:/Application%20V4.0/database/migrations/025_user_departments.sql)

Creates the many-to-many junction table and migrates existing data:

```sql
-- Junction table: user_departments
CREATE TABLE public.user_departments (
    id            UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id       UUID NOT NULL REFERENCES public.users(id),
    department_id UUID NOT NULL REFERENCES public.departments(id),
    is_primary    BOOLEAN NOT NULL DEFAULT false,
    created_at    TIMESTAMPTZ NOT NULL DEFAULT now(),
    UNIQUE(user_id, department_id)  -- prevent duplicate assignments
);

-- Indexes
CREATE INDEX idx_user_departments_user ON public.user_departments(user_id);
CREATE INDEX idx_user_departments_dept ON public.user_departments(department_id);

-- Migrate existing user→department relationships
INSERT INTO public.user_departments (user_id, department_id, is_primary)
SELECT id, department_id, true
FROM public.users
WHERE department_id IS NOT NULL
ON CONFLICT DO NOTHING;

-- RLS
ALTER TABLE public.user_departments ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.user_departments FORCE ROW LEVEL SECURITY;

-- Same-hospital users can see department assignments
CREATE POLICY user_depts_select ON public.user_departments
    FOR SELECT TO authenticated
    USING (
        EXISTS (
            SELECT 1 FROM public.users u
            WHERE u.id = user_departments.user_id
              AND u.hospital_id = public.get_my_hospital_id()
        )
    );

-- Only admins can manage assignments
CREATE POLICY user_depts_manage ON public.user_departments
    FOR ALL TO authenticated
    USING (
        public.get_my_role() IN ('admin', 'medical_superintendent')
    );
```

